# Copia este archivo a .env.local para desarrollo local.
# En Vercel: Project → Settings → Environment Variables
# (Production, Preview y Development).

# --- App ---
# Dominio canónico. En local usa el puerto de `npm run dev`.
# En Vercel: https://tu-proyecto.vercel.app (o tu dominio).
VITE_PUBLIC_APP_URL=http://localhost:8080

# --- Supabase (Settings → API) ---
# Acepta la anon key JWT o la publishable key (sb_publishable_...).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Nunca expongas SUPABASE_SERVICE_ROLE_KEY en el frontend ni en Vercel
# como variable VITE_*. Si hace falta en el servidor, usa un nombre
# sin prefijo VITE_ y solo en funciones de servidor.

# Tras el primer deploy, en Supabase → Authentication → URL Configuration:
#   Site URL = el valor de VITE_PUBLIC_APP_URL de producción
#   Redirect URLs = https://tu-dominio.vercel.app/**
#   y https://*.vercel.app/** para previews
