# Copia este archivo a .env.local para desarrollo local.
# En Vercel: Project → Settings → Environment Variables
# (Production, Preview y Development).

# --- Supabase (Settings → API) ---
# Acepta la anon key JWT o la publishable key (sb_publishable_...).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Solo servidor (sin prefijo VITE_). Necesaria para el cron /api/ejecutar,
# el webhook de WhatsApp y para que el administrador cree cuentas.
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role

# IA opcional (OpenAI). Si falta, se usa el motor local en español.
# OPENAI_API_KEY=sk-...

# WhatsApp Cloud API (Meta). Webhook: https://tu-dominio/api/whatsapp
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# Nunca expongas SUPABASE_SERVICE_ROLE_KEY ni OPENAI_API_KEY ni WHATSAPP_TOKEN
# como variables VITE_*.

# Tras el primer deploy, en Supabase → Authentication → URL Configuration:
#   Site URL = https://tu-proyecto.vercel.app
#   Redirect URLs = https://tu-dominio.vercel.app/**
#   y https://*.vercel.app/** para previews
#
# En Authentication → Providers → Email, para el prototipo local puedes
# desactivar "Confirm email". El registro público no se usa: desactiva
# "Allow new users to sign up"; el administrador crea cuentas en /admin/usuarios.
#
# Primer administrador (SQL en Supabase):
#   update public.perfiles set rol = 'administrador' where correo = 'tu@correo';
